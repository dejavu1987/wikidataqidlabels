{
	"name": "wikidataqidlabels",
	"displayName": "Wikidata QID Labels",
	"description": "VS Code extension to show a description of the entity in Wikidata on hover",
	"version": "1.3.0",
	"icon": "images/wikidata_logo.png",
	"publisher": "blokhinnv",
	"repository": {
		"type": "git",
		"url": "https://github.com/blokhinnv/wikidataqidlabels"
	},
	"engines": {
		"vscode": "^1.82.0",
		"node": ">=18"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"hover",
		"wikidata",
		"qid",
		"label",
		"description"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./extension.js",
	"contributes": {
		"commands": [
			{
				"title": "Wikidata QID Labels: Enable",
				"command": "wikidataqidlabels.enableHover"
			},
			{
				"title": "Wikidata QID Labels: Disable",
				"command": "wikidataqidlabels.disableHover"
			},
			{
				"title": "Wikidata QID Labels: Copy QID",
				"command": "wikidataqidlabels.copyQid"
			},
			{
				"title": "Wikidata QID Labels: Open in Wikidata",
				"command": "wikidataqidlabels.openInWikidata"
			}
		],
		"configuration": {
			"properties": {
				"wikidataqidlabels.enableExtension": {
					"type": "boolean",
					"default": true
				},
				"wikidataqidlabels.wikidataLanguages": {
					"type": "string",
					"default": "en|ru",
					"description": "Pipe-separated Wikidata language codes used to look up labels and descriptions, in priority order."
				},
				"wikidataqidlabels.addLinkToEntity": {
					"type": "boolean",
					"default": true
				},
				"wikidataqidlabels.showAllLanguages": {
					"type": "boolean",
					"default": false,
					"description": "When true, the hover shows the label and description for every configured language that returned a value, instead of only the first match."
				},
				"wikidataqidlabels.documentSelector": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"**"
					],
					"description": "Glob patterns that limit which files the extension activates on. Defaults to all files."
				}
			}
		}
	},
	"scripts": {
		"lint": "eslint .",
		"test:unit": "mocha \"test/unit/**/*.test.js\"",
		"test:e2e": "node ./test/runTest.js",
		"pretest": "npm run lint",
		"test": "npm run test:unit && npm run test:e2e"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.6",
		"@types/node": "^18.19.0",
		"@types/vscode": "^1.82.0",
		"@vscode/test-electron": "^2.4.0",
		"eslint": "^8.57.0",
		"glob": "^10.3.10",
		"mocha": "^10.4.0"
	}
}
